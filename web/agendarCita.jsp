<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="modelo.*"%><%@page import="java.util.*"%><% List<Usuario> docs=new UsuarioDAO().listarDoctores(); List<Servicio> servs=new ServicioDAO().listar(); List<Horario> horas=new HorarioDAO().listar(); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="css/estilos.css"></head><body><div class="page"><div class="card"><h2>Agendar cita neurológica</h2><p>Revisa la disponibilidad y solicita tu cita. El doctor podrá aceptarla o rechazarla.</p><form action="CtrolCita" method="post"><div class="form-grid"><select name="identificacion_doctor" required><option value="">Seleccione médico</option><% for(Usuario d:docs){ %><option value="<%=d.getIdentificacion()%>"><%=d.getNombre()%> <%=d.getApellido()%></option><% } %></select><select name="id_servicio" required><option value="">Seleccione servicio</option><% for(Servicio s:servs){ %><option value="<%=s.getIdServicio()%>"><%=s.getNombreServicio()%></option><% } %></select><input type="date" name="fecha" required><input type="time" name="hora" required><textarea class="full" name="observacion" placeholder="Observación o motivo de consulta"></textarea></div><button>Solicitar cita</button></form></div><br><h2>Horarios disponibles</h2><table class="table"><tr><th>Médico</th><th>Día</th><th>Hora inicio</th><th>Hora fin</th></tr><% for(Horario h:horas){ %><tr><td><%=h.getNombreDoctor()%></td><td><%=h.getDiaSemana()%></td><td><%=h.getHoraInicio()%></td><td><%=h.getHoraFin()%></td></tr><% } %></table></div></body></html>
