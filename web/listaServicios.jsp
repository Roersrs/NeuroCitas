<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="modelo.*"%><%@page import="java.util.*"%><% List<Servicio> lista=new ServicioDAO().listar(); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="css/estilos.css"></head><body><div class="page"><div class="card"><h2>Servicios Neurológicos médicos</h2><form action="CtrolServicio" method="post"><input name="nombre_servicio" placeholder="Nombre del servicio" required><textarea name="descripcion" placeholder="Descripción"></textarea><button>Agregar servicio</button></form></div><br><table class="table"><tr><th>ID</th><th>Servicio</th><th>Descripción</th><th>Acción</th></tr><% for(Servicio s:lista){ %><tr><td><%=s.getIdServicio()%></td><td><%=s.getNombreServicio()%></td><td><%=s.getDescripcion()%></td><td><a class="btn danger" href="EliminarServicio?id=<%=s.getIdServicio()%>">Eliminar</a></td></tr><% } %></table></div></body></html>
