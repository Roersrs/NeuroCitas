<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="modelo.*"%><%@page import="java.util.*"%><% List<Usuario> lista=new UsuarioDAO().listadoDatos(); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="css/estilos.css"><title>NeuroCitas - Usuarios</title></head><body><div class="page"><div class="topbar"><h2>Usuarios registrados</h2><a class="btn" href="regUsuario.jsp">Agregar usuario</a></div><table class="table"><tr><th>Identificación</th><th>Nombre</th><th>Usuario</th><th>Teléfono</th><th>Perfil</th><th>Acciones</th></tr><% for(Usuario u:lista){ String perfil=u.getIdperfil()==1?"Administrador":u.getIdperfil()==2?"Doctor":"Cliente"; %><tr><td><%=u.getIdentificacion()%></td><td><%=u.getNombre()%> <%=u.getApellido()%></td><td><%=u.getUsuario()%></td><td><%=u.getTelefono()%></td><td><%=perfil%></td><td><a class="btn secondary" href="EditarUsuario.jsp?id=<%=u.getIdentificacion()%>">Editar</a> <a class="btn danger" onclick="return confirm('¿Eliminar usuario?')" href="EliminarUsuario?id=<%=u.getIdentificacion()%>">Eliminar</a></td></tr><% } %></table></div></body></html>
