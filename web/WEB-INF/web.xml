<?xml version="1.0" encoding="UTF-8"?>

<web-app version="6.0"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">

    <!-- ========================= -->
    <!-- SERVLETS PRINCIPALES -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>CtrolValidar</servlet-name>
        <servlet-class>controlador.CtrolValidar</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>CerrarSesion</servlet-name>
        <servlet-class>controlador.CerrarSesion</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ControladorRegistro</servlet-name>
        <servlet-class>controlador.ControladorRegistro</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ControladorUsuario</servlet-name>
        <servlet-class>controlador.ControladorUsuario</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EditarUsuario</servlet-name>
        <servlet-class>controlador.EditarUsuario</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EliminarUsuario</servlet-name>
        <servlet-class>controlador.EliminarUsuario</servlet-class>
    </servlet>

    <!-- ========================= -->
    <!-- SERVICIOS -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>CtrolServicio</servlet-name>
        <servlet-class>controlador.CtrolServicio</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EliminarServicio</servlet-name>
        <servlet-class>controlador.EliminarServicio</servlet-class>
    </servlet>

    <!-- ========================= -->
    <!-- HORARIOS -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>CtrolHorario</servlet-name>
        <servlet-class>controlador.CtrlHorario</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EliminarHorario</servlet-name>
        <servlet-class>controlador.EliminarHorario</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ControladorMisHorarios</servlet-name>
        <servlet-class>controlador.ControladorMisHorarios</servlet-class>
    </servlet>

    <!-- ========================= -->
    <!-- CITAS -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>CtrolCita</servlet-name>
        <servlet-class>controlador.CtrolCita</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>CambiarEstadoCita</servlet-name>
        <servlet-class>controlador.CambiarEstadoCita</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>CancelarCita</servlet-name>
        <servlet-class>controlador.CancelarCita</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>SolicitarCita</servlet-name>
        <servlet-class>controlador.SolicitarCita</servlet-class>
    </servlet>

    <!-- ========================= -->
    <!-- ROLES / SOLICITUDES -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>CambiarRolUsuario</servlet-name>
        <servlet-class>controlador.CambiarRolUsuario</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ControladorSolicitudDoctor</servlet-name>
        <servlet-class>controlador.ControladorSolicitudDoctor</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>GestionSolicitudDoctor</servlet-name>
        <servlet-class>controlador.GestionSolicitudDoctor</servlet-class>
    </servlet>

    <!-- ========================= -->
    <!-- HISTORIA CLÍNICA -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>CtrolHistoriaClinica</servlet-name>
        <servlet-class>controlador.CtrolHistoriaClinica</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>GuardarHistoriaClinica</servlet-name>
        <servlet-class>controlador.GuardarHistoriaClinica</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EditarHistoriaClinica</servlet-name>
        <servlet-class>controlador.EditarHistoriaClinica</servlet-class>
    </servlet>

    <!-- ========================= -->
    <!-- MAPPINGS PRINCIPALES -->
    <!-- ========================= -->

    <servlet-mapping>
        <servlet-name>CtrolValidar</servlet-name>
        <url-pattern>/CtrolValidar</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CerrarSesion</servlet-name>
        <url-pattern>/CerrarSesion</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ControladorRegistro</servlet-name>
        <url-pattern>/ControladorRegistro</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ControladorUsuario</servlet-name>
        <url-pattern>/ControladorUsuario</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EditarUsuario</servlet-name>
        <url-pattern>/EditarUsuario</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EliminarUsuario</servlet-name>
        <url-pattern>/EliminarUsuario</url-pattern>
    </servlet-mapping>

    <!-- ========================= -->
    <!-- MAPPINGS SERVICIOS -->
    <!-- ========================= -->

    <servlet-mapping>
        <servlet-name>CtrolServicio</servlet-name>
        <url-pattern>/CtrolServicio</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EliminarServicio</servlet-name>
        <url-pattern>/EliminarServicio</url-pattern>
    </servlet-mapping>

    <!-- ========================= -->
    <!-- MAPPINGS HORARIOS -->
    <!-- ========================= -->

    <servlet-mapping>
        <servlet-name>CtrolHorario</servlet-name>
        <url-pattern>/CtrolHorario</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EliminarHorario</servlet-name>
        <url-pattern>/EliminarHorario</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ControladorMisHorarios</servlet-name>
        <url-pattern>/ControladorMisHorarios</url-pattern>
    </servlet-mapping>

    <!-- ========================= -->
    <!-- MAPPINGS CITAS -->
    <!-- ========================= -->

    <servlet-mapping>
        <servlet-name>CtrolCita</servlet-name>
        <url-pattern>/CtrolCita</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CambiarEstadoCita</servlet-name>
        <url-pattern>/CambiarEstadoCita</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CancelarCita</servlet-name>
        <url-pattern>/CancelarCita</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SolicitarCita</servlet-name>
        <url-pattern>/SolicitarCita</url-pattern>
    </servlet-mapping>

    <!-- ========================= -->
    <!-- MAPPINGS ROLES / SOLICITUDES -->
    <!-- ========================= -->

    <servlet-mapping>
        <servlet-name>CambiarRolUsuario</servlet-name>
        <url-pattern>/CambiarRolUsuario</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ControladorSolicitudDoctor</servlet-name>
        <url-pattern>/ControladorSolicitudDoctor</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>GestionSolicitudDoctor</servlet-name>
        <url-pattern>/GestionSolicitudDoctor</url-pattern>
    </servlet-mapping>

    <!-- ========================= -->
    <!-- MAPPINGS HISTORIA CLÍNICA -->
    <!-- ========================= -->

    <servlet-mapping>
        <servlet-name>CtrolHistoriaClinica</servlet-name>
        <url-pattern>/CtrolHistoriaClinica</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>GuardarHistoriaClinica</servlet-name>
        <url-pattern>/GuardarHistoriaClinica</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EditarHistoriaClinica</servlet-name>
        <url-pattern>/EditarHistoriaClinica</url-pattern>
    </servlet-mapping>

    <!-- ========================= -->
    <!-- FILTRO DE SEGURIDAD -->
    <!-- ========================= -->

    <filter>
        <filter-name>SecurityFilter</filter-name>
        <filter-class>controlador.SecurityFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>