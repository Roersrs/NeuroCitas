<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="modelo.*"%><%@page import="java.util.*"%><% String id=(String)session.getAttribute("idUsuario"); List<Cita> lista=new CitaDAO().listarPorNeurólogo(id); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="css/estilos.css"></head><body><div class="page"><h2>Mis citas neurológicas como doctor</h2><table class="table"><tr><th>Cliente</th><th>Servicio</th><th>Fecha</th><th>Hora</th><th>Observación</th><th>Estado</th><th>Acciones</th></tr><% for(Cita c:lista){ %><tr><td><%=c.getNombreCliente()%></td><td><%=c.getNombreServicio()%></td><td><%=c.getFecha()%></td><td><%=c.getHora()%></td><td><%=c.getObservacion()%></td><td><span class="badge <%=c.getEstado()%>"><%=c.getEstado()%></span></td><td><a class="btn ok" href="CambiarEstadoCita?id=<%=c.getIdCita()%>&estado=Aceptada&volver=citasNeurólogo.jsp">Aceptar</a> <a class="btn danger" href="CambiarEstadoCita?id=<%=c.getIdCita()%>&estado=Rechazada&volver=citasNeurólogo.jsp">Rechazar</a></td></tr><% } %></table></div></body></html>
