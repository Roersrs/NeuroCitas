<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="modelo.*"%><%@page import="java.util.*"%><% String id=(String)session.getAttribute("idUsuario"); List<Cita> lista=new CitaDAO().listarPorCliente(id); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="css/estilos.css"></head><body><div class="page"><div class="topbar"><h2>Mis citas neurológicas</h2><a class="btn" href="agendarCita.jsp">Nueva cita</a></div><table class="table"><tr><th>Doctor</th><th>Servicio</th><th>Fecha</th><th>Hora</th><th>Observación</th><th>Estado</th><th>Acción</th></tr><% for(Cita c:lista){ %><tr><td><%=c.getNombreDoctor()%></td><td><%=c.getNombreServicio()%></td><td><%=c.getFecha()%></td><td><%=c.getHora()%></td><td><%=c.getObservacion()%></td><td><span class="badge <%=c.getEstado()%>"><%=c.getEstado()%></span></td><td><% if("Pendiente".equals(c.getEstado())){ %><a class="btn danger" href="CancelarCita?id=<%=c.getIdCita()%>">Cancelar</a><% } %></td></tr><% } %></table></div></body></html>
