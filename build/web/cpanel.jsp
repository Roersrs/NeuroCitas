<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="modelo.Usuario"%>
<%
Usuario actual=(Usuario)session.getAttribute("usuarioLogueado");
if(actual==null){response.sendRedirect("index.jsp");return;}
int perfil=actual.getIdperfil();
String rol=perfil==1?"Administrador":perfil==2?"Neurólogo":"Paciente";
String nombre=actual.getNombre()+" "+actual.getApellido();
String inicial=actual.getNombre()!=null&&!actual.getNombre().isEmpty()?actual.getNombre().substring(0,1).toUpperCase():"N";
%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NeuroCitas | <%=rol%></title>
<style>
*{box-sizing:border-box}html,body{margin:0;height:100%;font-family:'Segoe UI',Arial,sans-serif;background:#eef5fb;color:#10233f}.shell{display:grid;grid-template-columns:272px 1fr;height:100vh;overflow:hidden}.side{background:linear-gradient(180deg,#061a36 0%,#082449 55%,#061a36 100%);color:#fff;padding:24px 16px 18px;display:flex;flex-direction:column;box-shadow:10px 0 35px rgba(7,27,58,.12);position:relative;overflow:hidden}.side:after{content:'⌁';position:absolute;bottom:58px;right:-18px;font-size:150px;color:rgba(59,174,255,.04);transform:rotate(-18deg);pointer-events:none}.logo{display:flex;gap:12px;align-items:center;padding:0 7px 19px;border-bottom:1px solid rgba(255,255,255,.08)}.brain{width:48px;height:48px;border:2px solid #55bdff;border-radius:17px;display:grid;place-items:center;font-size:27px;box-shadow:0 0 25px rgba(46,169,255,.15)}.logo b{font-size:22px}.logo small{display:block;color:#79a9d3;letter-spacing:1.5px;font-size:9px;margin-top:3px}.user{margin:17px 5px 18px;padding:13px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);border-radius:16px;display:flex;align-items:center;gap:10px}.avatar{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#2478d8,#54c5ff);display:grid;place-items:center;font-weight:800}.user b{font-size:13px;display:block}.user span{font-size:11px;color:#89b8df}.label{font-size:9px;letter-spacing:1.8px;color:#648eb5;font-weight:800;padding:0 12px 8px}.nav{overflow:auto;scrollbar-width:none;position:relative;z-index:2}.nav a{display:flex;align-items:center;gap:11px;color:#c5d8ea;text-decoration:none;padding:11px 12px;margin:3px 0;border-radius:11px;font-size:13px;transition:.22s}.nav a:hover,.nav a.active{background:linear-gradient(90deg,#1168c8,#167bd8);color:#fff;transform:translateX(3px);box-shadow:0 7px 20px rgba(18,112,211,.25)}.ico{width:22px;text-align:center;font-size:16px}.logout{margin-top:auto;text-decoration:none;color:#fff;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:11px;text-align:center;font-size:13px;position:relative;z-index:2}.main{display:grid;grid-template-rows:72px 1fr;min-width:0}.top{background:rgba(255,255,255,.94);display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid #dfe9f4;box-shadow:0 5px 20px rgba(15,52,88,.05)}.hospital b{display:block;font-size:16px}.hospital span{font-size:12px;color:#6d87a5}.rolepill{background:#e8f4ff;color:#1264b5;padding:8px 13px;border-radius:999px;font-size:11px;font-weight:800}.framewrap{padding:18px;background:radial-gradient(circle at 90% 0,#dceeff 0,transparent 26%),#eef5fb;overflow:hidden}iframe{width:100%;height:100%;border:0;border-radius:22px;background:#f4f8fc;box-shadow:0 12px 35px rgba(13,53,91,.10)}@media(max-width:850px){.shell{grid-template-columns:78px 1fr}.logo div:last-child,.user div:last-child,.label,.nav a span:last-child{display:none}.side{padding:18px 10px}.logo{justify-content:center}.brain{width:42px;height:42px}.user{justify-content:center;padding:9px}.nav a{justify-content:center}.main{grid-template-rows:64px 1fr}.hospital span{display:none}.top{padding:0 15px}.framewrap{padding:9px}}
</style></head><body><div class="shell"><aside class="side"><div class="logo"><div class="brain">🧠</div><div><b>NeuroCitas</b><small>HOSPITAL NEUROCIENCIAS</small></div></div><div class="user"><div class="avatar"><%=inicial%></div><div><b><%=nombre%></b><span><%=rol%></span></div></div><div class="label">MENÚ PRINCIPAL</div><nav class="nav">
<a class="active" href="front.jsp" target="contenido"><i class="ico">⌂</i><span>Inicio</span></a>
<% if(perfil==1){ %>
<a href="listaUsuarios.jsp" target="contenido"><i class="ico">♟</i><span>Usuarios</span></a><a href="listaPerfiles.jsp" target="contenido"><i class="ico">◈</i><span>Perfiles</span></a><a href="listaServicios.jsp" target="contenido"><i class="ico">🧠</i><span>Servicios neurológicos</span></a><a href="listaHorarios.jsp" target="contenido"><i class="ico">▣</i><span>Horarios de neurólogos</span></a><a href="listaCitas.jsp" target="contenido"><i class="ico">✓</i><span>Todas las citas</span></a><a href="asignarRoles.jsp" target="contenido"><i class="ico">⚙</i><span>Asignar roles</span></a><a href="solicitudesDoctor.jsp" target="contenido"><i class="ico">▤</i><span>Solicitudes de neurólogos</span></a><a href="buscarHistoria.jsp" target="contenido"><i class="ico">⌕</i><span>Buscar historia clínica</span></a>
<% } else if(perfil==2){ %>
<a href="misHorarios.jsp" target="contenido"><i class="ico">▣</i><span>Mi horario</span></a><a href="misCitasDoctor.jsp" target="contenido"><i class="ico">✓</i><span>Mis citas</span></a><a href="buscarHistoria.jsp" target="contenido"><i class="ico">⌕</i><span>Historias clínicas</span></a>
<% } else { %>
<a href="solicitarCita.jsp" target="contenido"><i class="ico">＋</i><span>Solicitar cita</span></a><a href="misCitasPaciente.jsp" target="contenido"><i class="ico">▣</i><span>Mis citas</span></a><a href="miHistoriaClinica.jsp" target="contenido"><i class="ico">♡</i><span>Mi historia clínica</span></a>
<% } %></nav><a class="logout" href="CerrarSesion" onclick="return confirm('¿Seguro que deseas cerrar sesión?')">↪ Cerrar sesión</a></aside><main class="main"><header class="top"><div class="hospital"><b>Hospital Universitario Neurociencias</b><span>Atención especializada, tecnología y cuidado humano</span></div><div class="rolepill">● <%=rol%></div></header><div class="framewrap"><iframe src="front.jsp" name="contenido" id="contenido"></iframe></div></main></div><script>document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>{document.querySelectorAll('.nav a').forEach(x=>x.classList.remove('active'));a.classList.add('active')}));</script></body></html>
