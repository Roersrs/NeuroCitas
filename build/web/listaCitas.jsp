<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="modelo.*"%><%@page import="java.util.*"%><% List<Cita> lista=new CitaDAO().listarTodas(); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="css/estilos.css"></head><body><div class="page"><h2>Citas neurológicas</h2><table class="table"><tr><th>Cliente</th><th>Doctor</th><th>Servicio</th><th>Fecha</th><th>Hora</th><th>Estado</th><th>Observación</th></tr><% for(Cita c:lista){ %><tr><td><%=c.getNombreCliente()%></td><td><%=c.getNombreDoctor()%></td><td><%=c.getNombreServicio()%></td><td><%=c.getFecha()%></td><td><%=c.getHora()%></td><td><span class="badge <%=c.getEstado()%>"><%=c.getEstado()%></span></td><td><%=c.getObservacion()%></td></tr><% } %></table></div></body></html>
